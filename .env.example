# Server-only credentials. Copy to .env.local for local development; never commit values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# In Codex cloud settings, PLANET_OPENAI_KEY can supply the image key instead.
PLANET_OPENAI_KEY=

# Create a PUBLIC Vercel Blob store and connect it to this Vercel project.
BLOB_READ_WRITE_TOKEN=

# Upstash Redis REST endpoint and token. Required for live production operations.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=

# Global request ceilings per 24-hour window; also set account spend limits with providers.
DAILY_ANALYSIS_LIMIT=500
DAILY_IMAGE_LIMIT=100
DAILY_SHARE_LIMIT=500

# Explicit local development option only; ignored on Vercel and in NODE_ENV=production.
PSU7_ALLOW_LOCAL_QUOTAS=false

# Optional canonical production origin; Vercel production hostname is used by default.
SITE_URL=
