{
  "name": "psu7-planet-survey",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev-server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "check": "node --check app.js && node --check lib/planet.js && node --check lib/server.js && node --check lib/geography.js && node --check lib/globe.js && node --check lib/geography-worker.js",
    "build": "node scripts/build.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run format:check"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "undici": "6.29.1"
  }
}
