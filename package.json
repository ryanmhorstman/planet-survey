{
  "name": "psu7-planet-survey",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev-server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "check": "node scripts/check-syntax.js",
    "build": "node scripts/build.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run format:check",
    "typecheck": "tsc -p .",
    "eval": "node scripts/eval-narratives.js --curated",
    "eval:live": "node --env-file-if-exists=.env.local scripts/eval-narratives.js --live 40"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "24.10.1",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "undici": "6.29.1"
  }
}
